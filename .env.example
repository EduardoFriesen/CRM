# Copy to .env and replace every change-me with a strong random value (e.g. openssl rand -hex 32).
POSTGRES_PASSWORD=change-me
EVOLUTION_DB_PASSWORD=change-me
FLOWISE_DB_PASSWORD=change-me
EVOLUTION_API_KEY=change-me
FLOWISE_SECRETKEY_OVERWRITE=change-me
FLOWISE_JWT_AUTH_TOKEN_SECRET=change-me
FLOWISE_JWT_REFRESH_TOKEN_SECRET=change-me
FLOWISE_EXPRESS_SESSION_SECRET=change-me
FLOWISE_TOKEN_HASH_SECRET=change-me
# Host port nginx listens on (127.0.0.1 only; rootless docker cannot bind <1024).
HTTP_PORT=8080
